# Copy this file to .env and fill in your own keys. Never commit real keys.

# Required for the "AI Partner Discovery" web search feature.
# Free tier available at https://tavily.com
TAVILY_API_KEY=your_key_here

# Optional. Only used to lightly polish outreach messages and for the
# legacy single-company AI search tab. The app works fully without it.
ANTHROPIC_API_KEY=your_key_here
